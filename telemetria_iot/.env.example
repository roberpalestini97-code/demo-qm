# Copiar a .env. Sin ANTHROPIC_API_KEY el agente corre en modo "reglas" (sin costo).
ANTHROPIC_API_KEY=
AGENT_MODEL=claude-sonnet-5-5
SUMMARY_MODEL=claude-haiku-5-5
# Cada cuántos segundos revisa el agente y cada cuántos publica el data van.
AGENT_INTERVAL=120
SAMPLE_SECONDS=5
GRAFANA_ADMIN_PASSWORD=admin
