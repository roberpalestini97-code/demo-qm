    {
      "id": 7,
      "type": "timeseries",
      "title": "Presión de descarga por bomba (psi)",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "timescale"
      },
      "interval": "5s",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "timescale"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT time_bucket('$__interval', time) AS time, pump_id AS metric, avg(pressure_psi) AS value FROM telemetria WHERE $__timeFilter(time)  GROUP BY 1, 2 ORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "psi",
          "custom": {
            "lineWidth": 2,
            "showPoints": "never",
            "insertNulls": 60000
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
